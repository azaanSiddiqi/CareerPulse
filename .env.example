# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PROJECT_ID=your-project-id

# --- AI providers ---
# Set to 'anthropic' or 'openai'. Whichever you pick must have its key below.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Default models per provider (override per request if you want)
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=CareerPulse <reminders@yourdomain.dev>

# --- Cron auth ---
# Vercel Cron sets the Authorization header to this value when calling /api/cron/*
CRON_SECRET=generate-a-long-random-string

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
